# Modèle de configuration d'un environnement TaskFlow (staging ou production).
# À copier en .env dans le dossier de l'environnement, puis : chmod 600 .env
# Le .env contient de vrais secrets : il ne doit JAMAIS être commité.

# Propriétaire des images sur ghcr.io : votre pseudo GitHub EN MINUSCULES
GHCR_OWNER=votre-pseudo

# Environnement affiché par /health
APP_ENV=production

# Base de données
POSTGRES_USER=taskflow
POSTGRES_DB=taskflow
POSTGRES_PASSWORD=changez-moi
DATABASE_URL=postgres://taskflow:changez-moi@db:5432/taskflow

# Ports publiés par le proxy (8082 / 8443 si 80 / 443 sont déjà pris)
HTTP_PORT=80
HTTPS_PORT=443